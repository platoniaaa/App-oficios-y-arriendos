# Base path del sitio. Vercel sirve desde / por default.
VITE_BASE_PATH=/

# Modo del chatbot: 'mock' (default, sin API) o 'api' (con Claude/OpenAI).
VITE_CHATBOT_MODE=mock

# Supabase — REQUERIDAS en producción.
# Obtenelas en https://supabase.com/dashboard → tu proyecto → Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
